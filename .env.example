# Debian AI Assistant — configuration (DO NOT COMMIT)
#
#   cp .env.example .env && chmod 600 .env && nano .env
#   ./bin/import-keys.sh      # or pull keys from other local installs
#
# Every variable below is read by the services; none is decorative.
# The router starts with no keys at all — chat needs at least one cloud key,
# or a local Ollama.  Precedence rules: docs/CONFIG.md

# === Primary free rotation (recommended) ===================================
# Drives config/rotation-pool.json:openrouter_free and the 429 rotation.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://localhost/debian-ai
OPENROUTER_APP_TITLE="Debian AI Assistant"

# === Extra free/fast buckets (independent rate limits) =====================
GROQ_API_KEY=
OLLAMA_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# === Optional, not used by the spine yet ===================================
# Kept commented so nothing implies support that does not exist.
# VENICE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HF_TOKEN=

# === Router ==============================================================
DAI_ROUTER_HOST=127.0.0.1
DAI_ROUTER_PORT=11435
# Seconds a rate-limited model sits out (429).  Auth/quota failures cool the
# whole provider for DAI_PROVIDER_COOLDOWN_SECONDS instead.
DAI_COOLDOWN_SECONDS=90
DAI_SHORT_COOLDOWN_SECONDS=30
DAI_PROVIDER_COOLDOWN_SECONDS=600
# Per-attempt timeout for a normal request, and for a streaming one.
DAI_REQUEST_TIMEOUT=120
DAI_STREAM_TIMEOUT=600
# Timeout for the router's own outbound calls (status probes, pool refresh).
DAI_CLIENT_TIMEOUT=180
# Refuse to substitute a different model when an explicit id is unavailable.
# Default false = fall back to the rotation and say so in dai_routed.
# DAI_STRICT_MODELS=false
# Require `Authorization: Bearer <token>` on every route except /health.
# Leave unset for a localhost-only spine.
# DAI_ROUTER_TOKEN=
# DAI_MAX_BODY_BYTES=8388608
# DAI_QUIET_LOGS=false
# Point a provider somewhere else (proxy, mirror, or the test stub).
# DAI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DAI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# DAI_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# DAI_OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# DAI_OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1

# === Agent S worker =======================================================
DAI_AGENT_S_HOST=127.0.0.1
DAI_AGENT_S_PORT=8765
# Where the worker sends agent_s for inference (the router, by design).
DAI_MODEL_ROUTER=http://127.0.0.1:11435
# Where the skill scripts (skills/agent-s-delegate) send tasks.  Defaults to
# policy agent_s.worker_url; set this only to point them at another worker.
# DAI_AGENT_S_WORKER=http://127.0.0.1:8765
# Tasks are serialised: one GUI agent per display.  Raise only if you run more
# than one X display.
DAI_AGENT_S_CONCURRENCY=1
DAI_AGENT_S_MAX_QUEUE=32
DAI_AGENT_S_MAX_TASKS=200
# Default step budget per task.  Clamped to policy agent_s.max_steps_hard_cap,
# which is a safety key and can only be changed in the policy file.
DAI_AGENT_S_MAX_STEPS=15
# Where completed task records and artifacts are kept.
# DAI_AGENT_S_STATE=state/agent-s-tasks
# Require `Authorization: Bearer <token>` on the worker's routes.
# DAI_AGENT_S_TOKEN=
# DAI_AGENT_S_VENV=~/.local/agent-s-venv
# Timeout for the worker's own outbound calls to the router.
DAI_CLIENT_TIMEOUT=180

# --- Live GUI overrides (only consulted once policy allows a live run) -----
# "openai" means "through the router", which keeps cooldowns, redaction and
# the paid-model gate in force.  Any other value talks to that provider
# directly and bypasses the router.
AGENT_S_PROVIDER=openai
AGENT_S_MODEL=dai/auto
# AGENT_S_MODEL_URL=            # default: $DAI_MODEL_ROUTER/v1
# AGENT_S_API_KEY=              # default: $DAI_ROUTER_TOKEN, else a placeholder
AGENT_S_GROUND_PROVIDER=openai
AGENT_S_GROUND_MODEL=dai/vision-auto
# AGENT_S_GROUND_URL=           # default: $DAI_MODEL_ROUTER/v1
# AGENT_S_GROUND_API_KEY=
# Coordinate space the grounding model reasons in.  Leave these unset: they
# default to the policy values (1280x800), which match the agent display
# geometry above.  Setting them here overrides policy, so a mismatch means
# clicks land in the wrong place.
# AGENT_S_GROUNDING_WIDTH=1280
# AGENT_S_GROUNDING_HEIGHT=800
# AGENT_S_DISPLAY=:99
# AGENT_S_DISPLAY_GEOMETRY=1280x800x24
# AGENT_S_TIMEOUT=600
# AGENT_S_ALLOW_XVFB=1
# AGENT_S_EXTRA_ARGS=           # extra agent_s flags, shell-quoted

# === Advanced: relocate the config files ==================================
# Paths are normally derived from the repo root; override only if you keep
# policy somewhere else.  (DAI_ENV selects the .env file itself, so it has to
# be set in the real environment — putting it here would be circular.)
# DAI_POLICY=policy/sovereign.json
# DAI_APPROVALS=policy/approvals.json
