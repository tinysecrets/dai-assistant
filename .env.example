# Debian AI Assistant — secrets (DO NOT COMMIT)
# Copy from .env.example:  cp .env.example .env
# Fill any keys you have. Router starts without them; chat needs ≥1 cloud key
# (or local Ollama running).

# === Primary free rotation (recommended) ===
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://localhost/debian-ai
OPENROUTER_APP_TITLE="Debian AI Assistant"

# === Extra free/fast buckets (rotation across rate limits) ===
GROQ_API_KEY=
OLLAMA_API_KEY=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# === Optional / later ===
# VENICE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HF_TOKEN=

# === Agent S (only when you enable live GUI) ===
# AGENT_S_PROVIDER=open_router
# AGENT_S_MODEL=z-ai/glm-5.2:free
# AGENT_S_GROUND_URL=http://127.0.0.1:8080
# AGENT_S_GROUND_MODEL=ui-tars-1.5-7b
# AGENT_S_GROUNDING_WIDTH=1920
# AGENT_S_GROUNDING_HEIGHT=1080

# === Router tuning ===
DAI_COOLDOWN_SECONDS=90
DAI_ROUTER_HOST=127.0.0.1
DAI_ROUTER_PORT=11435
DAI_AGENT_S_HOST=127.0.0.1
DAI_AGENT_S_PORT=8765
