#!/bin/bash
# ==============================================================================
# D-A-I Universal Speech Dictation (Super+D / Clickable Launcher)
# Captures speech from Samsung S22 Ultra (s22-mic)
# Transcribes locally with Whisper and pastes directly into ANY active window:
# Web chat boxes (Arena/ChatGPT/Firefox), terminals, editors, documents.
# ==============================================================================

set -euo pipefail

BASE="$HOME/.local/share/dhakidd-whisper"
WHISPER="$BASE/whisper-cli"
MODEL="$BASE/ggml-base.en.bin"
STATE="$HOME/.local/state/dhakidd-dictate"
PIDFILE="$STATE/recording.pid"
WAV="$STATE/dictation.wav"
LOCK="$STATE/lock"

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

mkdir -p "$STATE"
exec 9>"$LOCK"
flock -n 9 || exit 0

# --- State 1: Already recording -> Stop, Transcribe, and Paste ---
if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    pid=$(cat "$PIDFILE")
    kill -INT "$pid" 2>/dev/null || true

    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    kill -TERM "$pid" 2>/dev/null || true
    sleep 0.2
    kill -9 "$pid" 2>/dev/null || true
    rm -f "$PIDFILE"

    if [ ! -s "$WAV" ]; then
        notify-send '🎤 Dictation' 'No audio captured from S22.' 2>/dev/null || true
        exit 0
    fi

    rm -f "$WAV.txt"
    TEXT=""
    if [ -x "$WHISPER" ] && [ -s "$MODEL" ]; then
        "$WHISPER" -m "$MODEL" -t 6 -l en -nt -otxt "$WAV" >/dev/null 2>&1 || true
        TEXT=$(sed ':a;N;$!ba;s/\n/ /g' "$WAV.txt" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
    fi

    # Fallback to local Voice Bridge STT API (http://127.0.0.1:8766) if whisper-cli didn't produce text
    if [ -z "$TEXT" ]; then
        TEXT=$(curl -sf --max-time 15 -X POST http://127.0.0.1:8766/v1/audio/transcriptions \
            -F file=@"$WAV" -F model=base -F language=en 2>/dev/null | \
            python3 -c "import sys, json; print(json.load(sys.stdin).get('text', '').strip())" 2>/dev/null || true)
    fi

    if [ -n "$TEXT" ]; then
        # Use Clipboard Paste (Ctrl+V) so modern web chat boxes (React/Vue/Arena) receive it instantly
        if command -v xclip >/dev/null 2>&1; then
            OLD_CLIP=$(xclip -selection clipboard -o 2>/dev/null || true)
            printf '%s' "$TEXT" | xclip -selection clipboard
            xdotool key --clearmodifiers ctrl+v 2>/dev/null || xdotool type --clearmodifiers --delay 2 -- "$TEXT"
            (sleep 1 && printf '%s' "$OLD_CLIP" | xclip -selection clipboard 2>/dev/null) &
        elif command -v xsel >/dev/null 2>&1; then
            OLD_CLIP=$(xsel -b 2>/dev/null || true)
            printf '%s' "$TEXT" | xsel -b
            xdotool key --clearmodifiers ctrl+v 2>/dev/null || xdotool type --clearmodifiers --delay 2 -- "$TEXT"
            (sleep 1 && printf '%s' "$OLD_CLIP" | xsel -b 2>/dev/null) &
        else
            xdotool type --clearmodifiers --delay 2 -- "$TEXT"
        fi
        notify-send '🎤 Dictation' "Pasted: $TEXT" 2>/dev/null || true
    else
        notify-send '🎤 Dictation' 'No speech recognized. Check phone connection.' 2>/dev/null || true
    fi

    rm -f "$WAV" "$WAV.txt"
    exit 0
fi

# --- State 2: Start Recording ---
HAS_ENGINE=0
if [ -x "$WHISPER" ] && [ -s "$MODEL" ]; then
    HAS_ENGINE=1
elif curl -sf --max-time 2 http://127.0.0.1:8766/health >/dev/null 2>&1; then
    HAS_ENGINE=1
fi

[ "$HAS_ENGINE" -eq 1 ] || {
    notify-send '🎤 Dictation' 'Voice Bridge / Whisper engine is not running.' 2>/dev/null || true
    exit 1
}

rm -f "$WAV" "$WAV.txt"

# Find best capture source: prefer S22 Ultra (android-4f3b250 or s22-mic), else default
SOURCE="android-4f3b250"
if ! pactl list short sources 2>/dev/null | grep -q "android-4f3b250"; then
    if pactl list short sources 2>/dev/null | grep -q "s22-mic"; then
        SOURCE="s22-mic"
    else
        SOURCE=$(pactl get-default-source 2>/dev/null || echo "")
        case "$SOURCE" in
            *.monitor) SOURCE=$(pactl list short sources 2>/dev/null | awk '$2 !~ /\.monitor$/ {print $2; exit}') ;;
        esac
    fi
fi

[ -n "$SOURCE" ] || {
    notify-send '🎤 Dictation' 'No microphone source found.' 2>/dev/null || true
    exit 1
}

# Auto-timeout after 30 seconds so it never hangs in background
(
    ffmpeg -loglevel error -f pulse -i "$SOURCE" -ac 1 -ar 16000 -c:a pcm_s16le "$WAV" >/dev/null 2>&1
) &
REC_PID=$!
echo "$REC_PID" > "$PIDFILE"

# Watchdog: auto-stop after 30 seconds if user forgot to press Super+D
(
    sleep 30
    if [ -s "$PIDFILE" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" = "$REC_PID" ]; then
        kill -INT "$REC_PID" 2>/dev/null || true
    fi
) &

notify-send '🎤 Dictation' 'Listening to S22... Press Super+D or click icon when done.' 2>/dev/null || true
