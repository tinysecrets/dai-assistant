#!/usr/bin/env bash
# dai-test-voice — Interactive diagnostic for King Justin's hands-free voice loop
set -u
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

printf "${CYAN}====================================================\n"
printf " 🎙️  DAI VOICE SYSTEM DIAGNOSTIC — JUSTIN'S RIG\n"
printf "====================================================${NC}\n\n"

# 1. Check PipeWire / PulseAudio
printf "1. Audio Daemon (PipeWire/PulseAudio): "
if pactl info >/dev/null 2>&1; then
  SERVER="$(pactl info 2>/dev/null | grep 'Server Name' | cut -d: -f2- | xargs)"
  printf "${GREEN}RUNNING${NC} (%s)\n" "$SERVER"
else
  printf "${RED}FAILED${NC} (Cannot connect to audio server. Run: systemctl --user restart pipewire pipewire-pulse)\n"
fi

# 2. Check LG G8 Mic source
printf "2. Microphone Sources:\n"
SRC="android-87f1610"
if pactl list short sources 2>/dev/null | grep -q "$SRC"; then
  pactl set-source-mute "$SRC" false 2>/dev/null || true
  pactl set-source-volume "$SRC" 100% 2>/dev/null || true
  pactl set-default-source "$SRC" 2>/dev/null || true
  printf "   - LG G8 Phone Mic (${CYAN}%s${NC}): ${GREEN}FOUND & UNMUTED${NC} (Volume: 100%%)\n" "$SRC"
else
  printf "   - LG G8 Phone Mic (${YELLOW}%s${NC}): ${RED}NOT FOUND IN PULSE${NC}\n" "$SRC"
  printf "     Available sources:\n"
  pactl list short sources 2>/dev/null | awk '{print "       * "$2}' || true
fi

# 3. Test Mic Recording
TMP_WAV="/tmp/dai-test-mic.wav"
rm -f "$TMP_WAV"
printf "\n3. Testing 3-Second Mic Recording...\n"
printf "   ${YELLOW}>>> SAY SOMETHING INTO YOUR PHONE MIC NOW... <<<${NC}\n"

RECORDED=0
# Try parec with explicit device first
if parec -d "$SRC" --file-format=wav > "$TMP_WAV" 2>/dev/null & PID=$!; sleep 3; kill $PID 2>/dev/null; wait $PID 2>/dev/null || true; then
  if [[ -s "$TMP_WAV" ]]; then
    RECORDED=1
  fi
fi

# Fallback to arecord
if [[ "$RECORDED" -eq 0 ]]; then
  arecord -q -D pulse -f S16_LE -r 16000 -c 1 -d 3 -t wav "$TMP_WAV" 2>/dev/null || \
  arecord -q -f S16_LE -r 16000 -c 1 -d 3 -t wav "$TMP_WAV" 2>/dev/null || true
  if [[ -s "$TMP_WAV" ]]; then
    RECORDED=1
  fi
fi

if [[ "$RECORDED" -eq 1 && -s "$TMP_WAV" ]]; then
  BYTES=$(wc -c < "$TMP_WAV")
  python3 - "$TMP_WAV" <<'PY'
import sys, wave, struct, math
try:
    w = wave.open(sys.argv[1], 'rb')
    frames = w.readframes(w.getnframes())
    count = len(frames) // 2
    if count > 0:
        shorts = struct.unpack(f"<{count}h", frames)
        rms = math.sqrt(sum(s * s for s in shorts) / count)
        print(f"   Mic Capture: \033[0;32mSUCCESS\033[0m ({w.getframerate()}Hz, {w.getnchannels()}ch, {len(frames)} bytes, RMS Volume: {int(rms)})")
        if rms < 50:
            print("   \033[1;33mWarning: Volume is very low (near silence). Check phone mic gain.\033[0m")
        else:
            print(f"   \033[0;32mAudio signal detected! (RMS {int(rms)} > threshold)\033[0m")
except Exception as e:
    print(f"   \033[0;31mError reading WAV:\033[0m {e}")
PY
else
  printf "   Mic Capture: ${RED}FAILED${NC} (0 bytes recorded from mic)\n"
fi

# 4. Check Voice Bridge (STT / TTS)
printf "\n4. Voice Bridge Server (Port 8766):\n"
if curl -sf --max-time 3 http://127.0.0.1:8766/health >/dev/null 2>&1; then
  printf "   - Health Check: ${GREEN}ONLINE${NC}\n"
  
  if [[ -s "$TMP_WAV" ]]; then
    printf "   - Transcribing your test recording with Whisper... "
    TRANS="$(curl -sf --max-time 15 -X POST http://127.0.0.1:8766/v1/audio/transcriptions -F file=@"$TMP_WAV" -F model=whisper-1 2>/dev/null || echo "")"
    TEXT="$(python3 -c "import json,sys; doc=json.loads(sys.argv[1]) if sys.argv[1] else {}; print(doc.get('text',''))" "$TRANS" 2>/dev/null || echo "")"
    if [[ -n "$TEXT" ]]; then
      printf "${GREEN}SUCCESS${NC}\n"
      printf "     ${CYAN}Whisper Heard:${NC} \"${YELLOW}%s${NC}\"\n" "$TEXT"
    else
      printf "${YELLOW}NO WORDS RECOGNIZED (Silence or unintelligible)${NC}\n"
    fi
  fi
else
  printf "   - Health Check: ${RED}OFFLINE${NC} (Voice Bridge is not running on 8766)\n"
  printf "     ${YELLOW}Fix: Run './bin/dai up' to start the Voice Bridge service!${NC}\n"
fi

# 5. Check TTS Playback
printf "\n5. Audio Playback Test:\n"
if command -v edge-tts >/dev/null 2>&1; then
  printf "   - Edge-TTS (Natural Neural Voice): ${GREEN}INSTALLED${NC}\n"
  printf "   - Speaking test greeting through speakers...\n"
  edge-tts --voice en-US-GuyNeural --text "Justin, this is Day. Audio playback is working." --write-media /tmp/dai-test-out.mp3 2>/dev/null || true
  if [[ -s /tmp/dai-test-out.mp3 ]]; then
    if command -v mpv >/dev/null 2>&1; then
      mpv --no-terminal /tmp/dai-test-out.mp3 >/dev/null 2>&1 || true
    elif command -v paplay >/dev/null 2>&1; then
      paplay /tmp/dai-test-out.mp3 >/dev/null 2>&1 || true
    fi
    rm -f /tmp/dai-test-out.mp3
  fi
else
  printf "   - Edge-TTS: ${YELLOW}NOT INSTALLED${NC} (Using local Piper fallback)\n"
  printf "     Install for natural human voice: pip install --break-system-packages edge-tts\n"
fi

rm -f "$TMP_WAV"
printf "\n${CYAN}====================================================\n"
printf " Diagnostic Complete\n"
printf "====================================================${NC}\n"
