#!/usr/bin/env bash
# dai-gemini — Hands-free voice assistant (Google Gemini Live replica)
#   "Hey DAI", "Come here DAI", "DAI come here"
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Ensure voice venv Python is used if available, else python3
PY="python3"
if [[ -x "$HOME/.local/voice-venv/bin/python" ]]; then
  PY="$HOME/.local/voice-venv/bin/python"
fi

exec "$PY" "$ROOT/bin/dai-gemini.py" "$@"
