#!/usr/bin/env python3
"""DAI Voice Audition Tool — Hear the natural human neural voices."""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Ensure XDG_RUNTIME_DIR is set
if "XDG_RUNTIME_DIR" not in os.environ:
    os.environ["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

KOKORO_VOICES = [
    ("1", "Bella (Kokoro)", "af_bella", "Sultry, smooth, laid-back urban flow (Cool & effortless)"),
    ("2", "Nicole (Kokoro)", "af_nicole", "Confident, street-smart, rhythmic, and smooth"),
    ("3", "Heart (Kokoro)", "af_heart", "Warm, breathy, intimate, and soulful"),
    ("4", "Sarah (Kokoro)", "af_sarah", "Soft, relaxed, down-to-earth, and affectionate"),
    ("5", "Sky (Kokoro)", "af_sky", "Lively, modern, sharp, and natural"),
]

EDGE_VOICES = [
    ("6", "Michelle (Edge)", "en-US-MichelleNeural", "Soulful, warm, authentic urban cadence"),
    ("7", "Aria (Edge)", "en-US-AriaNeural", "Confident, bold, rhythmic flow"),
    ("8", "Ava (Edge)", "en-US-AvaNeural", "Silky, modern, seductive"),
]


def play_audio(path: str) -> None:
    if shutil.which("paplay"):
        subprocess.run(["paplay", path], timeout=20, stderr=subprocess.DEVNULL, env=os.environ)
    elif shutil.which("mpv"):
        subprocess.run(["mpv", "--no-terminal", path], timeout=20, stderr=subprocess.DEVNULL, env=os.environ)
    elif shutil.which("aplay"):
        subprocess.run(["aplay", "-q", "-r", "24000", "-f", "S16_LE", path], timeout=20, stderr=subprocess.DEVNULL, env=os.environ)


def speak_kokoro(voice_id: str, text: str) -> bool:
    try:
        from lib.dai.kokoro_engine import synthesize_speech
        wav = synthesize_speech(text, voice=voice_id, speed=0.96)
        if wav and os.path.exists(wav):
            play_audio(wav)
            try:
                os.remove(wav)
            except Exception:
                pass
            return True
    except Exception as e:
        print(f"Kokoro error: {e}")
    return False


def speak_edge(voice_id: str, text: str) -> bool:
    with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as f:
        tmp_mp3 = f.name
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        tmp_wav = f.name
    try:
        cmd = ["edge-tts", "--voice", voice_id, "--rate=+2%", "--text", text, "--write-media", tmp_mp3]
        res = subprocess.run(cmd, capture_output=True, timeout=15, env=os.environ)
        if res.returncode == 0 and os.path.exists(tmp_mp3):
            if shutil.which("ffmpeg"):
                subprocess.run(["ffmpeg", "-y", "-i", tmp_mp3, "-ar", "24000", "-ac", "1", tmp_wav], capture_output=True, timeout=10, env=os.environ)
                play_audio(tmp_wav)
            else:
                play_audio(tmp_mp3)
            return True
    except Exception:
        pass
    finally:
        for p in (tmp_mp3, tmp_wav):
            try:
                os.remove(p)
            except Exception:
                pass
    return False


def main() -> None:
    print("=" * 65)
    print(" 🎙️  DAY VOICE AUDITION — KING JUSTIN'S SUITE")
    print("=" * 65)

    from lib.dai.kokoro_engine import is_kokoro_available, ensure_kokoro_installed

    has_kokoro = is_kokoro_available()
    if not has_kokoro:
        print("\nKokoro-82M human voice engine is not yet installed.")
        print("Would you like to install it now? (Takes ~15s, 116MB total)")
        ans = input("Install Kokoro? [Y/n]: ").strip().lower()
        if ans in ("", "y", "yes"):
            has_kokoro = ensure_kokoro_installed()

    sample_phrase = "What it do, my boy... What we doing for it?"

    if has_kokoro:
        print("\n--- 🌟 LOCAL HUMAN NEURAL VOICES (KOKORO-82M) ---")
        for num, name, voice_id, desc in KOKORO_VOICES:
            print(f"\n[{num}] {name}...")
            print(f"    Style: {desc}")
            speak_kokoro(voice_id, sample_phrase)

    print("\n--- ☁️  CLOUD BACKUP VOICES (EDGE-TTS) ---")
    for num, name, voice_id, desc in EDGE_VOICES:
        print(f"\n[{num}] {name}...")
        print(f"    Style: {desc}")
        speak_edge(voice_id, sample_phrase)

    print("\n" + "=" * 65)
    choice = input("Enter voice number to lock in [1-8] (default: 1 Bella): ").strip()
    selected_voice = "af_bella"
    engine = "kokoro"

    for num, name, voice_id, _ in KOKORO_VOICES:
        if choice == num:
            selected_voice = voice_id
            engine = "kokoro"
            print(f"✅ Selected: {name} (Kokoro: {voice_id})")
            break

    for num, name, voice_id, _ in EDGE_VOICES:
        if choice == num:
            selected_voice = voice_id
            engine = "edge"
            print(f"✅ Selected: {name} (Edge: {voice_id})")
            break

    config_file = Path.home() / ".dai-voice"
    config_file.write_text(f"export DAI_VOICE_ENGINE=\"{engine}\"\nexport DAI_VOICE=\"{selected_voice}\"\nexport DAI_KOKORO_VOICE=\"{selected_voice}\"\n")
    print(f"\nSaved preference to {config_file}!")


if __name__ == "__main__":
    main()
