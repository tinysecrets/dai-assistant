#!/usr/bin/env bash
# ==============================================================================
# S22 Ultra Unified Microphone Streamer (Pure Silent Pipe - ZERO FEEDBACK)
# Streams Samsung S22 Ultra microphone into PipeWire virtual node 's22-mic'
# Guaranteed 100% silent on speakers: --no-playback writes directly to FIFO
# Feeds DAI Assistant, Dictator (Super+D), and Browser Voice Search seamlessly
# ==============================================================================

set -uo pipefail

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

CONF="$HOME/.config/dhakidd-bridge.conf"
USB_SERIAL="RFCT428ZRSZ"
PHONE_TS_IP=""
PIPE_FILE="/tmp/s22_mic_pipe"

if [ -f "$CONF" ]; then
    # shellcheck source=/dev/null
    source "$CONF" 2>/dev/null || true
fi

# Clean up any previous pipe or modules
for id in $(pactl list short modules 2>/dev/null | grep -E 's22-mic|s22_mic' | awk '{print $1}'); do
    pactl unload-module "$id" 2>/dev/null || true
done
rm -f "$PIPE_FILE"
mkfifo "$PIPE_FILE"

# Hold FIFO open so PipeWire never receives EOF during reconnects
exec 3<>"$PIPE_FILE"

ensure_pipe_source() {
    if ! pactl list short sources 2>/dev/null | grep -q "s22-mic"; then
        echo "[S22 Mic]: Loading silent PipeWire capture pipe 's22-mic'..."
        pactl load-module module-pipe-source source_name=s22-mic channels=1 format=s16le rate=48000 file="$PIPE_FILE" >/dev/null 2>&1 || true
    fi
    pactl set-source-mute s22-mic false 2>/dev/null || true
    pactl set-source-volume s22-mic 100% 2>/dev/null || true
    pactl set-default-source s22-mic 2>/dev/null || true
}

find_s22_device() {
    # 1. Prefer direct USB connection if active
    if adb devices 2>/dev/null | grep -E "^${USB_SERIAL}\s+device" >/dev/null; then
        echo "$USB_SERIAL"
        return 0
    fi

    # 2. Check Tailscale / Wi-Fi IP if defined
    if [ -n "$PHONE_TS_IP" ]; then
        if adb devices 2>/dev/null | grep -E "^${PHONE_TS_IP}:[0-9]+\s+device" >/dev/null; then
            adb devices 2>/dev/null | awk -v ip="$PHONE_TS_IP" '$1 ~ ("^" ip ":[0-9]+$") && $2=="device"{print $1; exit}'
            return 0
        fi
        adb connect "${PHONE_TS_IP}:5555" >/dev/null 2>&1 || true
        sleep 1
        if adb devices 2>/dev/null | grep -E "^${PHONE_TS_IP}:[0-9]+\s+device" >/dev/null; then
            adb devices 2>/dev/null | awk -v ip="$PHONE_TS_IP" '$1 ~ ("^" ip ":[0-9]+$") && $2=="device"{print $1; exit}'
            return 0
        fi
    fi

    # 3. Any active authorized adb device that is NOT the old LG G8
    local any_dev
    any_dev="$(adb devices 2>/dev/null | awk '$1 !~ /LMG820/ && $2=="device"{print $1; exit}')"
    if [ -n "$any_dev" ]; then
        echo "$any_dev"
        return 0
    fi

    return 1
}

echo "=== S22 Ultra Silent Microphone Daemon Started ==="
ensure_pipe_source

while true; do
    DEV="$(find_s22_device || true)"
    if [ -z "$DEV" ]; then
        sleep 3
        continue
    fi

    ensure_pipe_source
    echo "[S22 Mic]: Connected to S22 ($DEV). Streaming silently to pipe (zero speaker sound)..."

    # Pure silent capture: --no-playback guarantees ZERO sound on speakers
    scrcpy -s "$DEV" \
        --no-video \
        --no-window \
        --no-playback \
        --audio-source=mic \
        --audio-codec=raw \
        --record-format=wav \
        --record="$PIPE_FILE" \
        --audio-buffer=50 >/dev/null 2>&1 || true

    echo "[S22 Mic]: Stream closed. Reconnecting in 2s..."
    sleep 2
done
