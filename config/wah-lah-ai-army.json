  "model_selection": {
    "source": "live FreeLLMAPI catalog",
    "active_only_after_successful_live_probe": true,
    "prioritize_families": [
      "Nemotron Ultra 550B",
      "Nemotron Super 120B",
      "Qwen 397B/235B",
      "Hermes 405B",
      "Llama 405B",
      "GLM flagship",
      "Nex-N2.5 Pro",
      "strongest verified free coding models"
    ],
    "never_auto_substitute_a_smaller_model_without_disclosing_it": true,
    "team_lead_and_reviewer_must_be_distinct_models": true
  },
  "tool_fabric": {
    "filesystem_shell": {
      "service": "Debian local OS",
      "status": "requires live probe"
    },
    "computer_use": {
      "service": "Agent-S",
      "endpoint": "http://127.0.0.1:8768",
      "approval_gated": true,
      "dry_run_default": true
    },
    "browser_agent": {
      "service": "OpenClaw Gateway",
      "status": "requires live capability probe"
    },
    "android": {
      "service": "ADB + scrcpy + Horus",
      "status": "requires per-device live probe"
    },
    "network": {
      "service": "Tailscale + SSH",
      "status": "requires live probe"
    },
    "voice": {
      "service": "Genie voice bridge",
      "endpoint": "http://127.0.0.1:8766"
    },
    "model_gateway": {
      "service": "DAI model router",
      "endpoint": "http://127.0.0.1:11435"
    },
    "model_catalog": {
      "service": "FreeLLMAPI",
      "endpoint": "http://100.105.171.108:3001/v1/models"
    }
  },
  "consensus": {
    "compare_evidence": true,
    "preserve_disagreement": true,
    "synthesis_may_not_fabricate_agreement": true,
    "execution_requires_authorization": true
  },
